lumns[\n","    lr_pipeline.named_steps['feature_selection'].get_support()\n","]\n","\n","# Get the trained Logistic Regression model\n","lr_model = lr_pipeline.named_steps['model']\n","\n","# Create mesh grid\n","x_min, x_max = X_train_selected[:, 0].min() - 0.5, X_train_selected[:, 0].max() + 0.5\n","y_min, y_max = X_train_selected[:, 1].min() - 0.5, X_train_selected[:, 1].max() + 0.5\n","\n","xx, yy = np.meshgrid(\n","    np.linspace(x_min, x_max, 300),\n","    np.linspace(y_min, y_max, 300)\n",")\n","\n","# Predict for every point in the grid\n","grid = np.c_[xx.ravel(), yy.ravel()]\n","Z = lr_model.predict(grid)\n","Z = Z.reshape(xx.shape)\n","\n","# Plot decision regions\n","plt.figure(figsize=(8, 6))\n","\n","plt.contourf(\n","    xx,\n","    yy,\n","    Z,\n","    alpha=0.2\n",")\n","\n","# Scatter plot\n","scatter = plt.scatter(\n","    X_train_selected[:, 0],\n","    X_train_selected[:, 1],\n","    c=y_train,\n","    edgecolor='k',\n","    s=60\n",")\n","\n","plt.xlabel(selected_features[0])\n","plt.ylabel(selected_features[1])\n","\n","plt.title(\n","    f\"Logistic Regression Decision Boundary\\n\"\n","    f\"Accuracy: {accuracy:.2f}\"\n",")\n","\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":585},"id":"Pb4NncXBpuoZ","executionInfo":{"status":"ok","timestamp":1789234185444,"user_tz":-180,"elapsed":502,"user":{"displayName":"جهاد شريف","userId":"12067959749496098809"}},"outputId":"76910e3d-e438-4ed2-8528-6fa06dfb5fd8"},"execution_count":188,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["# ✦ ✦ ✦"],"metadata":{"id":"4NBUm877oaUX"}},{"cell_type":"markdown","source":["# 🎯 **Logistic Regression - Hyperparameter Tuning**"],"metadata":{"id":"BgbhSOCnokVu"}},{"cell_type":"code","source":["from sklearn.pipeline import Pipeline\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.feature_selection import SelectKBest, f_classif\n","from sklearn.linear_model import LogisticRegression\n","from sklearn.model_selection import GridSearchCV\n","\n","# Create pipeline\n","lr_pipeline = Pipeline([\n","    ('scaler', StandardScaler()),\n","    ('feature_selection', SelectKBest(score_func=f_classif, k=4)),\n","    ('model', LogisticRegression(random_state=42))\n","])\n","\n","# Define values of C to test\n","param_grid = {\n","    'model__C': [0.001, 0.01, 0.1, 1, 10, 100]\n","}\n","\n","# Grid Search with Cross-Validation\n","grid_search = GridSearchCV(\n","    estimator=lr_pipeline,\n","    param_grid=param_grid,\n","    cv=5,\n","    scoring='accuracy',\n","    n_jobs=-1\n",")\n","\n","# Train and tune the model\n","grid_search.fit(X_train, y_train)\n","\n","print(\"Best C:\", grid_search.best_params_['model__C'])\n","print(f\"Best CV Accuracy: {grid_search.best_score_:.2f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"d9l9_vTSntgD","executionInfo":{"status":"ok","timestamp":1789234198837,"user_tz":-180,"elapsed":562,"user":{"displayName":"جهاد شريف","userId":"12067959749496098809"}},"outputId":"c882d1a1-a008-4d17-c596-b30acf67f051"},"execution_count":189,"outputs":[{"output_type":"stream","name":"stdout","text":["Best C: 10\n","Best CV Accuracy: 0.97\n"]}]},{"cell_type":"code","source":["# @title\n","# Get GridSearchCV results\n","results = grid_search.cv_results_\n","\n","C_values = np.array(results['param_model__C'], dtype=float)\n","mean_scores = results['mean_test_score']\n","std_scores = results['std_test_score']\n","\n","# Plot\n","plt.figure(figsize=(8, 5))\n","\n","plt.plot(\n","    C_values,\n","    mean_scores,\n","    marker='o',\n","    linewidth=2,\n","    label='Mean CV Accuracy'\n",")\n","\n","# Add standard deviation\n","plt.fill_between(\n","    C_values,\n","    np.array(mean_scores) - np.array(std_scores),\n","    np.array(mean_scores) + np.array(std_scores),\n","    alpha=0.2\n",")\n","\n","# Mark best C\n","best_C = grid_search.best_params_['model__C']\n","best_score = grid_search.best_score_\n","\n","plt.scatter(\n","    best_C,\n","    best_score,\n","    s=100,\n","    zorder=5,\n","    label=f'Best C = {best_C}'\n",")\n","\n","plt.xscale('log')\n","\n","plt.xlabel('Regularization Parameter (C)')\n","plt.ylabel('Cross-Validation Accuracy')\n","\n","plt.title('Logistic Regression — Hyperparameter Tuning')\n","\n","plt.legend()\n","plt.grid(alpha=0.3)\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":506},"id":"i66mK4bqrudg","executionInfo":{"status":"ok","timestamp":1789234444518,"user_tz":-180,"elapsed":1712,"user":{"displayName":"جهاد شريف","userId":"12067959749496098809"}},"outputId":"eae47128-505f-40de-ce2b-5c0dbf0dcf8a"},"execution_count":197,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Best Model Evaluation\n","\n","from sklearn.metrics import accuracy_score\n","\n","# Get the best model\n","best_lr_model = grid_search.best_estimator_\n","\n","# Predict on test data\n","y_pred = best_lr_model.predict(X_test)\n","\n","# Calculate test accuracy\n","test_accuracy = accuracy_score(y_test, y_pred)\n","\n","print(f\"Test Accuracy: {test_accuracy:.2f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"xaEV1cQQn7NY","executionInfo":{"status":"ok","timestamp":1789234208944,"user_tz":-180,"elapsed":33,"user":{"displayName":"جهاد شريف","userId":"12067959749496098809"}},"outputId":"3ad27ad3-f482-4c26-85e8-d378fc202933"},"execution_count":190,"outputs":[{"output_type":"stream","name":"stdout","text":["Test Accuracy: 0.97\n"]}]},{"cell_type":"markdown","source":["<div align=\"center\">\n","\n","<img src=\"https://storage.googleapis.com/kaggle-datasets-images/9587468/14978070/cee73e54e79de0487a63f584f14a88a6/dataset-card.jpeg?t=2026-02-27-07-30-33\" width=\"600\">\n","\n","</div>"],"